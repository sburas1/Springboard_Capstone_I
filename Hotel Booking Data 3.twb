                <groupfilter function='level-members' level='[none:Reservation_status_date_month:nk]' />
                <groupfilter function='level-members' level='[none:Reservation_status_year:ok]' />
              </groupfilter>
              <groupfilter function='reorder-dimensionality'>
                <groupfilter function='union'>
                  <groupfilter function='crossjoin'>
                    <groupfilter function='member' level='[none:Reservation_status_year:ok]' member='2015' />
                    <groupfilter function='union'>
                      <groupfilter function='member' level='[none:Reservation_status_date_month:nk]' member='&quot;Apr&quot;' />
