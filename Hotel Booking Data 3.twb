            <column-instance column='[Reservation_status_year]' derivation='None' name='[none:Reservation_status_year:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_605171257689939969]' derivation='User' name='[usr:Calculation_605171257689939969:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0qj6vdk1hw8r4t1fm82h30xmcbm7].[Exclusions (Reservation status date month,Reservation status year)]'>
