          <formatted-text>
            <run fontcolor='#000000' fontname='Times New Roman' fontsize='11'>Bookings Made 90+ Days in Advance</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='hotel_bookings (1)' name='federated.0qj6vdk1hw8r4t1fm82h30xmcbm7' />
