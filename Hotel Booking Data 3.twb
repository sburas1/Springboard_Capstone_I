    <dashboard enable-sort-zone-taborder='true' name='Problem Statement'>
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98002' id='89' param='horz' type-v2='layout-flow' w='98932' x='534' y='999'>
            <zone h='98002' id='22' param='horz' type-v2='layout-flow' w='88244' x='534' y='999'>
              <zone h='98002' id='3' param='vert' type-v2='layout-flow' w='88244' x='534' y='999'>
                <zone fixed-size='44' h='5493' id='10' is-fixed='true' param='horz' type-v2='layout-flow' w='88244' x='534' y='999'>
                  <zone forceUpdate='true' h='5493' id='11' type-v2='text' w='88244' x='534' y='999'>
                    <formatted-text>
                      <run fontcolor='#4e79a7' fontname='Times New Roman' fontsize='24'>Executive Summary</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                </zone>
                <zone fixed-size='97' forceUpdate='true' h='13109' id='5' is-fixed='true' type-v2='text' w='88244' x='534' y='6492'>
                  <formatted-text>
                    <run fontcolor='#f28e2b' fontname='Times New Roman' fontsize='16'>How can City Hotels increase their revenue (bookings) by decreasing their cancellation rate by at least 10% through customer retention strategies by the 31st of December 2018? </run>
                  </formatted-text>
