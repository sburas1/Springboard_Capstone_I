          <datasource-dependencies datasource='federated.0qj6vdk1hw8r4t1fm82h30xmcbm7'>
            <column caption='Non-Family_ &gt;90 Lead Time CR' datatype='real' name='[Calculation_605171257689939969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Is_canceled] = 1 AND [Families v. Non-Families] = &quot;Non-Family&quot; AND [Lead_time] &gt; 90&#13;&#10;THEN 1 &#13;&#10;ELSE 0 &#13;&#10;END) &#13;&#10;/&#13;&#10;SUM(IF [Families v. Non-Families] = &quot;Non-Family&quot; AND [Lead_time] &gt; 90&#13;&#10;THEN 1 &#13;&#10;ELSE 0 &#13;&#10;END)' />
            </column>
            <column datatype='string' name='[Families v. Non-Families]' role='dimension' type='nominal' />
            <column datatype='string' name='[Hotel]' role='dimension' type='nominal' />
